{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "resources": {
      "binaries/ffmpeg.exe": "ffmpeg.exe",
      "binaries/ffprobe.exe": "ffprobe.exe",
      "icons/icon.ico": "app.ico"
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
